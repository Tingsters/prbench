{
  "name": "prbench",
  "version": "0.3.0",
  "description": "Evaluate tools that write or change the pull requests AI coding agents produce.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "bin": {
    "prbench": "./src/cli.ts"
  },
  "files": [
    "src",
    "datasets",
    "scripts",
    "cases/example-greet-default",
    "docs",
    "README.md",
    "LICENSE",
    "bun.lock",
    "tsconfig.json"
  ],
  "scripts": {
    "prbench": "bun run src/cli.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "bun x tsc --noEmit",
    "example": "bun run scripts/make-example.ts"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.1.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
